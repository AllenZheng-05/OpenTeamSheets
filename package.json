{
  "name": "openteamsheets",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @ots/web dev",
    "dev:all": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/core/src/db/types.ts && prettier --write packages/core/src/db/types.ts",
    "data:pull": "pnpm --filter @ots/tools data:pull",
    "data:sync": "pnpm --filter @ots/worker data:sync"
  },
  "devDependencies": {
    "prettier": "^3",
    "supabase": "^2",
    "typescript": "^5"
  }
}
