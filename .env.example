# Copy this file to apps/web/.env.local (and apps/worker/.env for the worker).
# Placeholder names only: never commit real values.
# For local development, run `pnpm db:start`, then `pnpm supabase status` prints the local values.

# Public site URL, used for metadata and auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL and publishable key. Safe in the browser because row-level security protects every table.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key. Bypasses row-level security: server and worker code only.
# Never give it a NEXT_PUBLIC_ prefix, which would ship it to the browser.
SUPABASE_SECRET_KEY=
